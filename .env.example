# Core app configuration
APP_NAME=IncidentIQ
DATABASE_URL=sqlite:///./incidentiq.db

# Optional LLM provider configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight client configuration (the server must be running for Hindsight mode)
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentiq-memory

# Configure a strong random token to enable human approval transitions.
INCIDENTIQ_APPROVAL_TOKEN=
